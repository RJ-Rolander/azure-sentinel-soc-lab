# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed - .env.example is the template that IS committed.

# Service principal credentials used for the client-credentials (app-only)
# OAuth2 flow. This is the same service principal you already verified
# from PowerShell against the incidents API.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-here

# Needed by collect.py to build the ARM path to the Sentinel workspace:
# /subscriptions/{id}/resourceGroups/{rg}/providers/Microsoft.OperationalInsights/workspaces/{name}
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=your-resource-group-name
SENTINEL_WORKSPACE_NAME=your-log-analytics-workspace-name

# The Log Analytics workspace GUID (Settings > Agents > Workspace ID in the
# portal). This is different from the workspace *name* above - it's the id
# enrich.py uses as the query scope when calling api.loganalytics.io.
LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
